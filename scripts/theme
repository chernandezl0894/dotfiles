#!/usr/bin/env bash
# Cambia el tema de Alacritty, tmux, i3 y Neovim desde un solo lugar.
set -euo pipefail

# Resolver el repo incluso si este script está symlinkeado en ~/.local/bin.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DOTFILES_DIR="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

THEMES_DIR="$DOTFILES_DIR/themes"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
CURRENT="$CONFIG_DIR/current"
ACTIVE="$CONFIG_DIR/active"

list_themes() {
  local dir
  for dir in "$THEMES_DIR"/*/; do
    [ -d "$dir" ] || continue
    basename "$dir"
  done | sort
}

current_theme() {
  if [ -L "$CURRENT" ]; then
    basename "$(readlink "$CURRENT")"
  fi
}

windows_alacritty_dir() {
  if [ -n "${WIN_ALACRITTY:-}" ] && [ -d "$WIN_ALACRITTY" ]; then
    printf '%s\n' "$WIN_ALACRITTY"
    return 0
  fi

  local dir
  for dir in /mnt/c/Users/*/AppData/Roaming/alacritty; do
    if [ -f "$dir/alacritty.toml" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
  done
}

sync_opencode() {
  local name="$1" mapping cfg
  mapping="$THEMES_DIR/$name/opencode.json"
  [ -f "$mapping" ] || return 0

  if ! command -v python3 >/dev/null 2>&1; then
    echo "Aviso: python3 no encontrado; OpenCode no se actualizó" >&2
    return 0
  fi

  local targets=("${XDG_CONFIG_HOME:-$HOME/.config}/opencode/cli.json")
  [ -n "${WIN_OPENCODE_CONFIG:-}" ] && targets+=("$WIN_OPENCODE_CONFIG")
  for cfg in /mnt/c/Users/*/.config/opencode/cli.json; do
    [ -f "$cfg" ] && targets+=("$cfg")
  done

  for cfg in "${targets[@]}"; do
    [ -f "$cfg" ] || continue
    if python3 - "$cfg" "$mapping" <<'PY'
import json
import sys

config_path, mapping_path = sys.argv[1], sys.argv[2]
with open(config_path, encoding="utf-8") as fh:
    config = json.load(fh)
with open(mapping_path, encoding="utf-8") as fh:
    theme = json.load(fh)

if not isinstance(theme, dict) or "name" not in theme:
    raise SystemExit(1)

config["theme"] = {"name": theme["name"], "mode": theme.get("mode", "system")}
with open(config_path, "w", encoding="utf-8") as fh:
    json.dump(config, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
PY
    then
      echo "OpenCode: $cfg"
    else
      echo "Aviso: no se pudo actualizar $cfg" >&2
    fi
  done
}

sync_windows_nvim() {
  local name="$1" dir
  local dirs=()
  if [ -n "${WIN_NVIM:-}" ] && [ -d "$WIN_NVIM" ]; then
    dirs+=("$WIN_NVIM")
  else
    for dir in /mnt/c/Users/*/AppData/Local/nvim; do
      [ -f "$dir/init.lua" ] && dirs+=("$dir")
    done
  fi

  for dir in "${dirs[@]}"; do
    if cp "$THEMES_DIR/$name/nvim.lua" "$dir/theme-central.lua"; then
      echo "Neovim Windows: $dir/theme-central.lua"
    else
      echo "Aviso: no se pudo escribir en $dir" >&2
    fi
  done
}

sync_windows_alacritty() {
  local name="$1" dir
  dir="$(windows_alacritty_dir || true)"
  [ -n "$dir" ] || return 0

  if cp "$THEMES_DIR/$name/alacritty.toml" "$dir/theme.toml"; then
    touch "$dir/alacritty.toml"
    echo "Alacritty Windows: $dir/theme.toml"
    if ! grep -q "theme.toml" "$dir/alacritty.toml"; then
      echo "Aviso: agrega import = [\".../theme.toml\"] en $dir/alacritty.toml" >&2
    fi
  else
    echo "Aviso: no se pudo escribir en $dir" >&2
  fi
}

reload_apps() {
  # Alacritty recarga al tocar su configuración principal.
  if [ -f "$HOME/.config/alacritty/alacritty.toml" ]; then
    touch "$HOME/.config/alacritty/alacritty.toml"
  fi

  # tmux no expande ~ en source-file, pero aquí el shell ya expandió $HOME.
  if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
    tmux source-file "$CURRENT/tmux.conf" >/dev/null 2>&1 || true
  fi

  if command -v i3-msg >/dev/null 2>&1 && i3-msg -t get_version >/dev/null 2>&1; then
    i3-msg reload >/dev/null 2>&1 || true
  fi

  # Neovim escucha ~/.config/theme; el archivo active dispara el cambio.
}

set_theme() {
  local name="$1"
  if [ ! -d "$THEMES_DIR/$name" ]; then
    echo "Tema no encontrado: $name" >&2
    echo "Disponibles: $(list_themes | tr '\n' ' ')" >&2
    exit 1
  fi

  mkdir -p "$CONFIG_DIR"
  ln -sfn "$THEMES_DIR/$name" "$CURRENT"
  printf '%s\n' "$name" >"$ACTIVE"
  echo "Tema activo: $name"
  sync_windows_alacritty "$name"
  sync_windows_nvim "$name"
  sync_opencode "$name"
  reload_apps
}

usage() {
  cat <<'EOF'
Uso: theme <comando>

  theme list              Lista los temas disponibles
  theme current           Muestra el tema activo
  theme set <nombre>      Activa un tema
  theme next              Rota al siguiente tema
EOF
}

case "${1:-}" in
  list | ls)
    list_themes
    ;;
  current)
    current_theme
    ;;
  set)
    if [ $# -lt 2 ]; then
      usage
      exit 1
    fi
    set_theme "$2"
    ;;
  next)
    mapfile -t themes < <(list_themes)
    if [ ${#themes[@]} -eq 0 ]; then
      echo "No hay temas en $THEMES_DIR" >&2
      exit 1
    fi
    next="${themes[0]}"
    current="$(current_theme || true)"
    for i in "${!themes[@]}"; do
      if [ "${themes[$i]}" = "$current" ]; then
        next="${themes[$(((i + 1) % ${#themes[@]}))]}"
        break
      fi
    done
    set_theme "$next"
    ;;
  help | -h | --help | "")
    usage
    ;;
  *)
    echo "Comando desconocido: $1" >&2
    usage
    exit 1
    ;;
esac
