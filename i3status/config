general {
        output_format = "i3bar"
        colors = true
        interval = 5
        markup = "pango"
        color_good = "#98c379"
        color_degraded = "#e5c07b"
        color_bad = "#e06c75"
}

order += "wireless _first_"
order += "memory"
order += "battery 0"
order += "tztime lima"

wireless _first_ {
        format_up = " %essid"
        format_down = " off"
}

memory {
        format = " %percentage_used"
        threshold_degraded = 20%
        threshold_critical = 10%
}

battery 0 {
        format = "%status %percentage %remaining"
        format_down = "No battery"
        format_percentage = "%.0f%s"
        status_chr = ""
        status_bat = ""
        status_unk = "?"
        status_full = ""
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 15
}

tztime lima {
        format = " %a %d %b %H:%M"
        timezone = "America/Lima"
}
